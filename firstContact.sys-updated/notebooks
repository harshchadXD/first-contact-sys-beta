   ],
   "source": [
    "patch_path = Path(\"../data/site04_traceable_patch.json\")\n",
    "if patch_path.exists():\n",
    "    with patch_path.open() as f:\n",
    "        patch = json.load(f)\n",
    "    print(\"=== Extracted 100x100 Terrain Patch Statistics ===\")\n",
    "    print(f\"Patch ID: {patch['id']}\")\n",
    "    print(f\"Fidelity: {patch['fidelity']}\")\n",
    "    print(f\"Source: {patch['sourceLabel']}\")\n",
    "    print(f\"Elevation Range: {patch['minElevationMeters']} m to {patch['maxElevationMeters']} m (Reference Mean: {patch['referenceElevationMeters']} m)\")\n",
    "    print(f\"Median RMS Height Uncertainty: {patch['medianHeightErrorMeters']} m\")\n",
    "    print(\"\\nSampled Touchdown Positions on Rim:\")\n",
    "    for i, pos in enumerate(patch['sampledPositions'], 1):\n",
    "        print(f\"{i}. {pos['label']}: East={pos['eastMeters']}m, North={pos['northMeters']}m, Elev={pos['elevationMeters']}m, Slope={pos['slopeDeg']}°, Err={pos['heightErrorMeters']}m\")"
